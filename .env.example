# ─── AI Provider (use one) ────────────────────────────────────────────────────
# Current: Gemini (managed by corporate)
GEMINI_API_KEY=your-gemini-key-here
# Future: swap to Anthropic when key is available — only orchestrator.py changes
ANTHROPIC_API_KEY=

# ─── PostgreSQL (local Docker) ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/growthskope

# ─── Firestore Emulator ───────────────────────────────────────────────────────
FIRESTORE_EMULATOR_HOST=localhost:8080
GOOGLE_CLOUD_PROJECT=local-project

# ─── Pub/Sub Emulator ─────────────────────────────────────────────────────────
PUBSUB_EMULATOR_HOST=localhost:8085

# ─── Firebase Auth Emulator ───────────────────────────────────────────────────
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=DEBUG
# Set to true to bypass Firebase auth in local development (no emulator required)
SKIP_AUTH=true

# ─── Salesforce MCP (optional) ────────────────────────────────────────────────
VITE_SALESFORCE_MCP_URL=
VITE_SALESFORCE_API_KEY=

# ─── Frontend AI (Deal Coach) ─────────────────────────────────────────────────
# Required for AI Deal Coach in Opportunities — uses Gemini 2.5 Flash
VITE_GEMINI_API_KEY=your-gemini-key-here
